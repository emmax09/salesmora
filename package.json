{
  "name": "salesmora",
  "private": true,
  "packageManager": "pnpm@11.9.0",
  "engines": {
    "node": ">=24.15.0",
    "pnpm": ">=11.9.0"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev --parallel",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "check:source-lines": "node scripts/check-source-line-limits.mjs",
    "format": "prettier --config packages/config/prettier.json --write . --ignore-unknown",
    "format:check": "prettier --config packages/config/prettier.json --check . --ignore-unknown",
    "db:generate": "pnpm --filter @salesmora/database db:generate",
    "db:validate": "pnpm --filter @salesmora/database db:validate",
    "db:migrate": "pnpm --filter @salesmora/database db:migrate",
    "db:migrate:deploy": "pnpm --filter @salesmora/database db:migrate:deploy",
    "db:check": "pnpm --filter @salesmora/database db:check",
    "db:up": "docker compose --env-file .env -f infrastructure/docker/compose.yaml up -d",
    "db:down": "docker compose --env-file .env -f infrastructure/docker/compose.yaml down"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@next/eslint-plugin-next": "^16.4.5",
    "eslint": "^10.14.0",
    "globals": "^17.14.0",
    "prettier": "^3.9.10",
    "turbo": "^2.11.10",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1"
  }
}
